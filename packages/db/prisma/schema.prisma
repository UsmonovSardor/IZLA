// Izla.uz — Prisma schema (TZ v2.0 asosida)
// Postgres 16 + PostGIS (geo) + pgvector (AI/RAG) + pg_trgm (fuzzy search)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"] // Docker/Railway (debian) uchun
  // AI/RAG bosqichida qayta yoqiladi: previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Deploy-safe: PostGIS/pgvector talab qilinmaydi (hozircha ishlatilmaydi).
  // AI/geo-radius bosqichida: extensions = [postgis, vector, pg_trgm]
}

// ============================================================
// ENUMS
// ============================================================
enum Role {
  USER
  VENDOR
  MODERATOR
  ADMIN
  DEVELOPER // ko'chmas mulk: quruvchi kompaniya
  REALTOR // rieltor / agentlik
  SELLER // jismoniy shaxs sotuvchi
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// Vendor obuna tarifi (monetizatsiya: platforma take-rate + featured)
enum VendorPlan {
  FREE
  PRO
  PREMIUM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentProvider {
  PAYME
  CLICK
  UZUM
  UZCARD
  HUMO
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EscrowState {
  NONE
  HELD
  RELEASED
  REFUNDED
}

enum ReviewStatus {
  PUBLISHED
  PENDING
  REJECTED
}

enum Channel {
  SMS
  PUSH
  TELEGRAM
  EMAIL
}

// --- Ko'chmas mulk ---
enum PropertyType {
  NEW // yangi bino (novostroyka)
  CONSTRUCTION // qurilayotgan
  SECONDARY // ikkilamchi (eski)
  RENT // ijara (kelajakda)
}

enum ComplexStatus {
  PLANNING
  CONSTRUCTION
  ACTIVE
  DONE
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum LeadStatus {
  NEW
  CONTACTED
  MEETING
  CLOSED
}

enum RealEstateTarget {
  DEVELOPER
  COMPLEX
}

// --- Sug'urta (monetizatsiya: embedded insurance) ---
enum InsuranceType {
  OSAGO // majburiy avto javobgarlik sug'urtasi
  KASKO // avto to'liq (KASKO)
  TRAVEL // sayohat sug'urtasi
  PROPERTY // uy / mol-mulk sug'urtasi
  ACCIDENT // baxtsiz hodisadan sug'urta
  HEALTH // ixtiyoriy tibbiy sug'urta (VMD)
}

enum PolicyStatus {
  DRAFT // hisoblandi, hali sotib olinmagan (kotirovka)
  PENDING // to'lov kutilmoqda
  ACTIVE // amal qilmoqda
  EXPIRED // muddati tugagan
  CANCELLED // bekor qilingan
}

// --- Ipoteka (monetizatsiya: bank lead-gen) ---
enum MortgageStatus {
  NEW // yangi ariza
  CONTACTED // bank bog'landi
  APPROVED // tasdiqlandi
  FUNDED // kredit berildi (Izla komissiya oladi)
  REJECTED // rad etildi
}

// ============================================================
// CORE
// ============================================================
model User {
  id        String   @id @default(cuid())
  phone     String   @unique // real telefon yoki sintetik identifikator: tg:<id> / google:<sub>
  email     String?  @unique
  googleId  String?  @unique
  name      String?
  role      Role     @default(USER)
  coins     Int      @default(0)
  locale    String   @default("uz")
  avatarUrl String?
  lastLat   Float?
  lastLng   Float?
  referralCode String?  @unique // foydalanuvchining taklif kodi (talab bo'lganda yaratiladi)
  referredById String? // kim taklif qilgan
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referredBy      User?    @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referred        User[]   @relation("Referrals")

  vendors         Vendor[]
  bookings        Booking[]
  reviews         Review[]
  coinLedger      CoinLedger[]
  notifications   Notification[]
  aiConversations AiConversation[]
  favorites       Favorite[]
  propertyLeads   PropertyLead[]
  geoAlertPref    GeoAlertPref?
  sessions        Session[]
  companies       Company[]
  resume          Resume?
  jobApplications JobApplication[]
  savedJobs       SavedJob[]
  policies        InsurancePolicy[]
  mortgageLeads   MortgageLead[]

  @@index([role])
  @@map("users")
}

// Refresh-token sessiyalari (httpOnly cookie). Rotatsiya + qurilma ro'yxati + revoke.
model Session {
  id          String    @id @default(cuid())
  userId      String
  refreshHash String    @unique // refresh token sha256 hash (xom token faqat cookie'da)
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Telefon OTP challenge (kod hash, TTL, urinishlar, rate-limit uchun izlar).
model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("otp_challenges")
}

model Category {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  nameRu     String?
  nameEn     String?
  icon       String?
  attributes Json     @default("[]") // dinamik maydonlar sxemasi
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  vendors Vendor[]

  @@map("categories")
}

model Vendor {
  id          String       @id @default(cuid())
  ownerId     String
  categoryId  String
  name        String
  slug        String       @unique
  description String?
  lat         Float
  lng         Float
  address     String?
  district    String?
  status      VendorStatus @default(PENDING)
  verified    Boolean      @default(false)
  plan        VendorPlan   @default(FREE) // obuna tarifi (take-rate + ranking + featured)
  planActivatedAt DateTime?
  planExpiresAt   DateTime?
  rating      Float        @default(0)
  reviewCount Int          @default(0)
  hours       Json         @default("{}") // ish vaqti jadvali
  phone       String?
  socials     Json         @default("{}")
  photos      String[]     @default([])
  attributes  Json         @default("{}") // kategoriyaga xos qiymatlar
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [categoryId], references: [id])
  services Service[]
  staff    Staff[]
  bookings Booking[]
  reviews  Review[]

  @@index([categoryId])
  @@index([status])
  @@index([district])
  @@map("vendors")
}

model Service {
  id          String   @id @default(cuid())
  vendorId    String
  name        String
  price       Decimal  @db.Decimal(12, 2)
  durationMin Int      @default(30)
  staffId     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id])
  bookings Booking[]

  @@index([vendorId])
  @@map("services")
}

model Staff {
  id        String   @id @default(cuid())
  vendorId  String
  name      String
  avatarUrl String?
  schedule  Json     @default("{}")
  createdAt DateTime @default(now())

  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  services Service[]
  bookings Booking[]

  @@index([vendorId])
  @@map("staff")
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  vendorId  String
  serviceId String
  staffId   String?
  slotStart DateTime
  slotEnd   DateTime
  status    BookingStatus @default(PENDING)
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Lifecycle avtomatizatsiya (cron) uchun idempotentlik belgilari
  remindedAt        DateTime?
  reviewRequestedAt DateTime?

  user    User     @relation(fields: [userId], references: [id])
  vendor  Vendor   @relation(fields: [vendorId], references: [id])
  service Service  @relation(fields: [serviceId], references: [id])
  staff   Staff?   @relation(fields: [staffId], references: [id])
  payment Payment?
  review  Review?

  // double-booking himoyasi: bir usta bir vaqtda bitta bron
  @@unique([staffId, slotStart])
  @@index([userId])
  @@index([vendorId])
  @@index([slotStart])
  @@map("bookings")
}

model Payment {
  id          String          @id @default(cuid())
  bookingId   String?         @unique
  policyId    String?         @unique // sug'urta polisi uchun to'lov (embedded insurance)
  userId      String
  amount           Decimal    @db.Decimal(12, 2) // so'm (UZS)
  commissionAmount Decimal    @default(0) @db.Decimal(12, 2) // Izla take-rate (bron uchun)
  netAmount        Decimal?   @db.Decimal(12, 2) // vendorga o'tadigan sof summa
  currency    String          @default("UZS")
  provider    PaymentProvider // tanlangan provayder (checkout uchun)
  status      PaymentStatus   @default(PENDING)
  escrowState EscrowState     @default(NONE)
  externalId  String? // to'langan tranzaksiyaning tashqi ID'si (Payme _id / Click trans_id)
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  booking      Booking?             @relation(fields: [bookingId], references: [id])
  policy       InsurancePolicy?     @relation(fields: [policyId], references: [id])
  transactions PaymentTransaction[]

  @@index([userId])
  @@index([status])
  @@map("payments")
}

// Provayder tranzaksiya state-mashinasi. Payme bitta invoice uchun bir nechta
// tranzaksiya yaratishi mumkin (spec talabi), shu bois alohida jadval.
model PaymentTransaction {
  id            String          @id @default(cuid())
  paymentId     String
  provider      PaymentProvider
  providerTxnId String // Payme `_id` yoki Click `click_trans_id`
  // Payme konvensiyasi: 1=yaratilgan, 2=to'langan, -1=(1-holatda) bekor, -2=(2-holatda) bekor
  state         Int             @default(1)
  amount        Decimal         @db.Decimal(12, 2)
  createTime    DateTime? // provayder yaratish vaqti (ms aniqlikda)
  performTime   DateTime? // to'langan vaqt
  cancelTime    DateTime? // bekor qilingan vaqt
  reason        Int? // Payme bekor qilish sababi kodi
  raw           Json? // xom callback (audit / debug)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTxnId])
  @@index([paymentId])
  @@map("payment_transactions")
}

model Review {
  id          String       @id @default(cuid())
  userId      String
  vendorId    String
  bookingId   String?      @unique
  rating      Int // 1..5
  text        String?
  photos      String[]     @default([])
  criteria    Json         @default("{}") // {service, cleanliness, price, staff}
  vendorReply String?
  status      ReviewStatus @default(PUBLISHED)
  likes       Int          @default(0)
  createdAt   DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id])
  vendor  Vendor   @relation(fields: [vendorId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([vendorId])
  @@map("reviews")
}

model CoinLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  balance   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("coins_ledger")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  channel   Channel
  type      String
  payload   Json      @default("{}")
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  messages  Json     @default("[]")
  context   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("ai_conversations")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  vendorId   String?
  propertyId String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@unique([userId, vendorId])
  @@unique([userId, propertyId])
  @@map("favorites")
}

// ============================================================
// KO'CHMAS MULK (Real Estate vertical)
// ============================================================
model Developer {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  description   String?
  verified      Boolean  @default(false)
  rating        Float    @default(0)
  phone         String?
  address       String?
  lat           Float?
  lng           Float?
  projectsCount Int      @default(0)
  createdAt     DateTime @default(now())

  complexes Complex[]

  @@map("developers")
}

model Complex {
  id               String        @id @default(cuid())
  developerId      String
  name             String
  slug             String        @unique
  lat              Float
  lng              Float
  district         String?
  description      String?
  status           ComplexStatus @default(CONSTRUCTION)
  completionDate   DateTime?
  readinessPercent Int           @default(0)
  priceFrom        Decimal?      @db.Decimal(14, 2)
  pricePerM2       Decimal?      @db.Decimal(12, 2)
  amenities        Json          @default("[]")
  photos           String[]      @default([])
  createdAt        DateTime      @default(now())

  developer           Developer            @relation(fields: [developerId], references: [id], onDelete: Cascade)
  properties          Property[]
  constructionUpdates ConstructionUpdate[]
  leads               PropertyLead[]

  @@index([developerId])
  @@index([status])
  @@index([district])
  @@map("complexes")
}

model Property {
  id          String         @id @default(cuid())
  type        PropertyType
  complexId   String?
  ownerId     String? // jismoniy shaxs / rieltor
  title       String
  description String?
  price       Decimal        @db.Decimal(14, 2)
  pricePerM2  Decimal?       @db.Decimal(12, 2)
  currency    String         @default("UZS")
  areaM2      Float
  rooms       Int
  floor       Int?
  totalFloors Int?
  lat         Float
  lng         Float
  district    String?
  status      PropertyStatus @default(AVAILABLE)
  attributes  Json           @default("{}")
  photos      String[]       @default([])
  createdAt   DateTime       @default(now())

  complex   Complex?       @relation(fields: [complexId], references: [id])
  leads     PropertyLead[]
  favorites Favorite[]

  @@index([type])
  @@index([status])
  @@index([district])
  @@index([complexId])
  @@map("properties")
}

model PropertyLead {
  id         String     @id @default(cuid())
  propertyId String?
  complexId  String?
  userId     String
  name       String
  phone      String
  message    String?
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
  complex  Complex?  @relation(fields: [complexId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@index([status])
  @@map("property_leads")
}

model ConstructionUpdate {
  id               String   @id @default(cuid())
  complexId        String
  date             DateTime @default(now())
  readinessPercent Int
  note             String?
  photos           String[] @default([])

  complex Complex @relation(fields: [complexId], references: [id], onDelete: Cascade)

  @@index([complexId])
  @@map("construction_updates")
}

model GeoAlertPref {
  id        String   @id @default(cuid())
  userId    String   @unique
  radiusKm  Int      @default(5)
  districts String[] @default([])
  priceMin  Decimal? @db.Decimal(14, 2)
  priceMax  Decimal? @db.Decimal(14, 2)
  types     String[] @default([])
  channels  String[] @default(["PUSH"])
  enabled   Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("geo_alert_prefs")
}

// ============================================================
// IZLA ISH — mehnat bozori vertikali (HeadHunter darajasi)
// ============================================================

enum JobEmployment {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobExperience {
  NONE // tajribasiz
  JUNIOR // 1-3 yil
  MIDDLE // 3-6 yil
  SENIOR // 6+ yil
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  NEW
  VIEWED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

// Ish beruvchi kompaniya profili
model Company {
  id        String   @id @default(cuid())
  ownerId   String
  slug      String   @unique
  name      String
  logo      String?
  cover     String?
  about     String?
  industry  String?
  size      String? // "1-10", "11-50", "51-200", "200+"
  website   String?
  district  String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jobs  Job[]

  @@index([ownerId])
  @@map("companies")
}

// Vakansiya
model Job {
  id          String        @id @default(cuid())
  companyId   String
  title       String
  description String
  employment  JobEmployment @default(FULL_TIME)
  remote      Boolean       @default(false)
  region      String? // shahar/viloyat
  experience  JobExperience @default(JUNIOR)
  salaryMin   Int? // so'm (oyiga)
  salaryMax   Int?
  currency    String        @default("UZS")
  skills      String[]      @default([])
  category    String? // erkin kategoriya (IT, Sotuv, Marketing...)
  status      JobStatus     @default(ACTIVE)
  featured    Boolean       @default(false)
  views       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  expiresAt   DateTime?

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  savedBy      SavedJob[]

  @@index([status])
  @@index([companyId])
  @@index([region])
  @@index([experience])
  @@map("jobs")
}

// Nomzod rezyumesi (v1: har foydalanuvchiga bitta)
model Resume {
  id              String   @id @default(cuid())
  userId          String   @unique
  headline        String
  summary         String?
  skills          String[] @default([])
  experienceYears Int      @default(0)
  phone           String?
  email           String?
  experience      Json     @default("[]") // [{title, company, from, to, desc}]
  education       Json     @default("[]") // [{degree, school, year}]
  fileUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@map("resumes")
}

// Ariza
model JobApplication {
  id        String            @id @default(cuid())
  jobId     String
  userId    String
  resumeId  String?
  status    ApplicationStatus @default(NEW)
  coverNote String?
  aiScore   Int? // 0-100 AI moslik
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  job    Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@index([status])
  @@map("job_applications")
}

// Saqlangan vakansiya
model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@map("saved_jobs")
}

// ============================================================
// SUG'URTA (embedded insurance — monetizatsiya vertikali)
// ============================================================

// Sug'urta kompaniyasi (Kafil, Apex, Gross, ...). Izla = agent/distribyutor.
model Insurer {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  license     String? // litsenziya raqami
  rating      Float    @default(0)
  verified    Boolean  @default(false)
  phone       String?
  color       String? // brend rangi (UI aksenti)
  createdAt   DateTime @default(now())

  products InsuranceProduct[]

  @@map("insurers")
}

// Sug'urta mahsuloti (masalan: "Kafil OSAGO"). Tarif konfiguratsiyasi JSON'da —
// premiya shaffof formula bilan hisoblanadi (mijoz aniq summani ko'radi).
model InsuranceProduct {
  id             String        @id @default(cuid())
  insurerId      String
  type           InsuranceType
  name           String
  slug           String        @unique
  summary        String?
  // Bazaviy stavka + koeffitsentlar. Type'ga qarab shakl (osago/kasko/travel/...).
  tariff         Json          @default("{}")
  // Izla komissiyasi — premiyaning ulushi (0..1). 0.2000 = 20%.
  commissionRate Decimal       @default(0) @db.Decimal(5, 4)
  priceFrom      Decimal?      @db.Decimal(14, 2) // "dan boshlab" narx (marketing/filtr)
  coverageFrom   Decimal?      @db.Decimal(16, 2) // sug'urta qoplamasi "dan"
  features       Json          @default("[]") // afzalliklar ro'yxati
  termsMonths    Int[]         @default([]) // mavjud muddatlar (oy)
  rating         Float         @default(0)
  popular        Boolean       @default(false)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  insurer  Insurer           @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  policies InsurancePolicy[]

  @@index([type])
  @@index([insurerId])
  @@index([active])
  @@map("insurance_products")
}

// Sotib olingan / hisoblangan polis. breakdown = shaffof hisob-kitob (har koeffitsent).
model InsurancePolicy {
  id               String        @id @default(cuid())
  productId        String
  userId           String
  type             InsuranceType
  status           PolicyStatus  @default(PENDING)
  params           Json          @default("{}") // kiritilgan parametrlar (region, avto, kunlar...)
  premium          Decimal       @db.Decimal(14, 2) // mijoz to'laydigan summa (so'm)
  insuredSum       Decimal       @db.Decimal(16, 2) // sug'urta qoplamasi (so'm)
  commissionAmount Decimal       @default(0) @db.Decimal(14, 2) // Izla ulushi (so'm)
  breakdown        Json          @default("[]") // [{label, value, note}] — shaffoflik
  termMonths       Int           @default(12)
  policyNumber     String?       @unique
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  product InsuranceProduct @relation(fields: [productId], references: [id])
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("insurance_policies")
}

// ============================================================
// IPOTEKA (embedded lending — bank lead-gen)
// ============================================================

// Hamkor bank (Ipoteka beruvchi). Izla lead yetkazadi, bank komissiya to'laydi.
model Bank {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  license     String?
  rating      Float    @default(0)
  verified    Boolean  @default(false)
  phone       String?
  color       String?
  createdAt   DateTime @default(now())

  programs MortgageProgram[]

  @@map("banks")
}

// Ipoteka dasturi (masalan: "Ipoteka Bank — Yangi uy 17%").
model MortgageProgram {
  id            String   @id @default(cuid())
  bankId        String
  name          String
  slug          String   @unique
  summary       String?
  annualRate    Decimal  @db.Decimal(5, 2) // yillik foiz stavkasi (%)
  maxTermMonths Int      @default(240) // maksimal muddat (oy)
  minDownPct    Int      @default(15) // boshlang'ich to'lov (%)
  maxAmount     Decimal? @db.Decimal(16, 2) // maksimal kredit summasi (so'm)
  propertyTypes String[] @default([]) // NEW/SECONDARY/... yoki bo'sh = barchasi
  features      Json     @default("[]")
  // Izla komissiyasi — moliyalashtirilgan kreditga fiks so'm (biznes tomoni).
  referralFee   Decimal  @default(0) @db.Decimal(14, 2)
  monthlyFrom   Decimal? @db.Decimal(14, 2) // "dan boshlab" oylik to'lov (marketing/filtr)
  rating        Float    @default(0)
  popular       Boolean  @default(false)
  subsidized    Boolean  @default(false) // imtiyozli davlat dasturi
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bank  Bank           @relation(fields: [bankId], references: [id], onDelete: Cascade)
  leads MortgageLead[]

  @@index([active])
  @@index([bankId])
  @@map("mortgage_programs")
}

// Ipoteka arizasi (lead). propertyId/complexId — ixtiyoriy kontekst (FK'siz).
model MortgageLead {
  id             String         @id @default(cuid())
  programId      String?
  propertyId     String?
  complexId      String?
  userId         String
  amount         Decimal        @db.Decimal(16, 2) // kredit summasi
  propertyPrice  Decimal        @db.Decimal(16, 2) // obyekt narxi
  downPayment    Decimal        @db.Decimal(16, 2) // boshlang'ich to'lov
  termMonths     Int
  monthlyPayment Decimal        @db.Decimal(14, 2) // hisoblangan oylik to'lov
  name           String
  phone          String
  status         MortgageStatus @default(NEW)
  createdAt      DateTime       @default(now())

  program MortgageProgram? @relation(fields: [programId], references: [id])
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("mortgage_leads")
}
