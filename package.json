{
  "name": "izla",
  "version": "0.1.0",
  "private": true,
  "description": "Izla.uz — O'zbekiston №1 xizmatlar super-platformasi (monorepo)",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @izla/db generate",
    "db:migrate": "pnpm --filter @izla/db migrate",
    "db:seed": "pnpm --filter @izla/db seed",
    "db:studio": "pnpm --filter @izla/db studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  }
}
