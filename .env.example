# ===== Izla.uz environment (nusxa) — .env ga ko'chiring =====
# --- Database (docker-compose: 5433 portda) ---
DATABASE_URL="postgresql://izla:izla@localhost:5434/izla?schema=public"

# --- Backend (NestJS) ---
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Redis / Search ---
REDIS_URL="redis://localhost:6380"
MEILI_HOST="http://localhost:7701"
MEILI_MASTER_KEY="izla_dev_master_key"

# --- Telegram (bot token — user beradi) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="IzlaUzBot"
TELEGRAM_MINIAPP_URL="http://localhost:3000/tg"

# --- AI (Claude) ---
ANTHROPIC_API_KEY=""

# --- SMS (Eskiz) ---
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="Izla.uz"
