# ===== Izla.uz environment (nusxa) — .env ga ko'chiring =====
# --- Database (docker-compose: 5433 portda) ---
DATABASE_URL="postgresql://izla:izla@localhost:5434/izla?schema=public"

# --- Backend (NestJS) ---
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# --- Auth ---
# PROD SHART: kamida 24 belgili, bir-biridan farqli maxfiy qiymatlar.
# Generatsiya: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# Prod'da 'dev-*'/qisqa/bir xil sir bilan API ISHGA TUSHMAYDI (bootstrap bloklaydi).
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Prod (cross-site cookie) → true (SameSite=None;Secure). Dev localhost → false (Lax).
# PROD'da true bo'lishi SHART (aks holda bootstrap bloklaydi).
COOKIE_SECURE="false"
# Swagger /docs prod'da default O'CHIQ. Vaqtincha yoqish uchun: true
ENABLE_SWAGGER=""
# Ommaviy API URL (Google OAuth redirect uchun). Masalan: https://api-...up.railway.app
PUBLIC_API_URL=""

# --- Google OAuth — bo'sh bo'lsa Google kirish o'chiq ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Bo'sh bo'lsa: ${PUBLIC_API_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=""

# --- Redis / Search ---
REDIS_URL="redis://localhost:6380"
MEILI_HOST="http://localhost:7701"
MEILI_MASTER_KEY="izla_dev_master_key"

# --- Telegram (bot token — user beradi) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="IzlaUzBot"
TELEGRAM_MINIAPP_URL="http://localhost:3000/tg"

# --- AI (Claude) ---
ANTHROPIC_API_KEY=""

# --- Observability (Sentry) — bo'sh bo'lsa o'chiq (no-op) ---
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# --- SMS (Eskiz) — bo'sh bo'lsa SMS o'chiq (log rejimi) ---
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"
ESKIZ_BASE="https://notify.eskiz.uz/api"

# --- To'lov: Web return URL (checkout'dan keyin qaytish) ---
# Bo'sh bo'lsa CORS_ORIGIN birinchi qiymatiga fallback bo'ladi.
WEB_URL="http://localhost:3000"

# --- To'lov: Payme (Paycom) Merchant API ---
# Merchant kabinetdan olinadi. PAYME_MERCHANT_KEY bo'sh bo'lsa Payme callback'lari o'chiq.
PAYME_MERCHANT_ID=""
PAYME_MERCHANT_KEY=""
PAYME_CHECKOUT_URL="https://checkout.paycom.uz"

# --- To'lov: Click Merchant (SHOP) API ---
# CLICK_SECRET_KEY + CLICK_SERVICE_ID bo'sh bo'lsa Click callback'lari o'chiq.
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
CLICK_CHECKOUT_URL="https://my.click.uz/services/pay"

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="Izla.uz"
